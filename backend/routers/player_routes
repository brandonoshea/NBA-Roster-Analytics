from fastapi import APIRouter, Depends, HTTPException, Query
from sqlalchemy import func
from sqlalchemy.orm import Session

from db.database import get_db
from models.salary import Player
from models.salary import PlayerSeason
from schemas.players import PlayerListItem, PlayerDetail

router = APIRouter(
    prefix="/players",
    tags=["players"]
)

@router.get("", response_model=list[PlayerListItem])
def list_players(
    skip: int = 0,
    limit: int = 50,
    db: Session = Depends(get_db),
):
    latest_season = db.query(func.max(PlayerSeason.season)).scalar()

    players = (
        db.query(Player)
        .join(PlayerSeason, Player.id == PlayerSeason.player_id)
        .filter(PlayerSeason.season == latest_season)
        .order_by(PlayerSeason.points.desc())
        .offset(skip)
        .limit(limit)
        .all()
    )

    return players
